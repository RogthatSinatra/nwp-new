{{>navbar}}
<div class="container-fluid">
</div>


<!-- /21800390415/mpu_3 -->
{{>adx}}
{{>adrect}}

<div class="container-fluid no-slider">
    <div id="content" class="clearfix col-sm-12">
        <div class="row">
            <div id="main" class="col-sm-12 clearfix" role="main">
            	<a href="https://www.instagram.com/rogthatsinatra" target="_blank"><h2><img src="/images/bio/{{title}}.jpg" width="100" height="100" style="object-fit: cover; border-radius: 100%;"> Posted By {{title}}<em>Senior Staff Writer</em></h2></a>

                <div class="row load-more" id='items'>
                    {{#if posts}}
                    {{#each posts}}
                    <div class="article-block loader col-lg-4 col-md-4 col-sm-6" id="post-187973" role="article">
                        <a href="/p/{{this.permalink}}">
                            <img data-src="{{this.mainimage}}" class="lazy skeleton img-responsive wp-post-image">
                        </a>
                        <div class="post-details">
                            <div class="meta">
                                <ul>
                                    <li class="cat-parent"><a>{{this.category}}</a></li>
                                    <li>{{this.date}}</li>
                                </ul>
                            </div>
                            <a href="/p/{{this.permalink}}">
                                <h2>{{this.title}}</h2>
                            </a>
                            
                        </div>
                    </div> <!-- end article -->
                    {{/each}}
                    {{/if}}

                    {{#if reviews}}
                    {{#each reviews}}
                    <div class="article-block loader col-lg-4 col-md-4 col-sm-6" id="post-187973" role="article">
                        <a href="/review/{{this.permalink}}">
                            <img data-src="{{this.mainimage}}" class="lazy skeleton img-responsive wp-post-image">
                        </a>
                        <div class="post-details">
                            <div class="meta">
                                <ul>
                                    <li class="cat-parent"><a>reviews</a></li>
                                    <li>{{this.date}}</li>
                                </ul>
                            </div>
                            <a href="/review/{{this.permalink}}">
                                <h2>{{this.project}}</h2>
                            </a>
                            <a href="/review/{{this.permalink}}">
                            
                        </div>
                    </div> <!-- end article -->
                    {{/each}}
                    {{/if}}
                          {{#if lists}}
                    {{#each lists}}
                    <div class="article-block loader col-lg-4 col-md-4 col-sm-6" id="post-187973" role="article">
                        <a href="/list/{{this.permalink}}">
                            <img data-src="{{this.mainimage}}" class="lazy skeleton img-responsive wp-post-image">
                        </a>
                        <div class="post-details">
                            <div class="meta">
                                <ul>
                                    <li class="cat-parent"><a>Lists</a></li>
                                    <li>{{this.date}}</li>
                                </ul>
                            </div>
                            <a href="/list/{{this.permalink}}">
                                <h2>{{this.title}}</h2>
                            </a>
                    
                        </div>
                    </div> <!-- end article -->
                    {{/each}}
                    {{/if}}
                </div>
              
                <div id="advertpp"></div><br/><br/><br/><br/><br/>
            </div>
        </div>
    </div> <!-- end container -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script type="text/javascript" src="/js/loadposts.js"></script>