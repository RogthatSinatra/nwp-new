{{>preload}}
{{>navbar}}
<section class="popular-posts-column-area mt-60 mb-35">
    <div class="container">
        <div class="row">
            <div class="section-title">
                <h2 class="title-block">
                    {{title}}

                </h2>
                {{#if userx}}
                <img class="lazy biopic" data-src="/images/bio/{{userx.display_name}}" alt="{{userx.display_name}}" title="{{userx.display_name}}" width="100"><br/>

                {{/if}} 
            </div>
        </div>
        <div class="row">
            {{#each posts}}
            <div class="col-lg-4">
                <article class="post-block-style-wrapper post-block-template-one post-block-template-medium mb-40">
                    <div class="post-block-style-inner">
                        <div class="post-block-media-wrap">
                            <a href="{{this.permalink}}">
                                <img class="lazy" data-src="{{this.mainimage}}" alt="{{this.title}}">
                            </a>
                        </div>
                        <div class="post-block-content-wrap">
                            <div class="post-item-title">
                                <h2 class="post-title">
                                    <a href="{{this.permalink}}">{{this.title}}</a>
                                </h2>
                            </div>
                            <div class="post-excerpt-box">
                                <p>{{trimString this.summary 100}}...</p>
                            </div>
                            <div class="post-bottom-meta-list">
                                <div class="post-meta-author-box">
                                    By <a href="/a/{{hyphen this.author}}">{{hyphen this.author}}</a>
                                </div>
                                <div class="post-meta-date-box">
                                    {{dateFormat this.date}}
                                    {{#if ...user}}<span>&nbsp;&nbsp;&nbsp;<a href="/posts/{{this._id}}/edit" title="Edit article"><i class="far fa-pencil"></i> Edit</a></span>
                                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
            {{/each}}
            {{#if pagination}}
            <div class="row">
                <div class="col-lg-12">
                    <div class="blog-pagination-area mt-20">
                        <ul class="pagination page-numbers ">
                            <!-- {{#paginate pagination type="first"}}
      <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-numbers" href="?p={{n}}">First</a></li>
    {{/paginate}}  -->
                            {{#paginate pagination type="previous"}}
                            <li {{#if disabled}} class="disabled page-item" {{/if}}><a class="page-numbers" href="?p={{n}}"><i class="icofont-long-arrow-left"></i></a></li>
                            {{/paginate}}
                            {{#paginate pagination type="middle" limit="5"}}
                            {{#if active}} <li><span aria-current="page" class="page-numbers current">{{n}}</span></li>
                            {{else}}
                            <li class="page-item"><a class="page-numbers" href="?p={{n}}">{{n}}</a></li>
                            {{/if}}
                            {{/paginate}}
                            {{#paginate pagination type="next"}}
                            <li {{#if disabled}} class="disabled page-item" {{/if}}><a class="page-numbers" href="?p={{n}}"><i class="icofont-long-arrow-right"></i></a></li>
                            {{/paginate}}
                            <li>&nbsp;... &nbsp;</li>
                            {{#paginate pagination type="last"}}
                            <li {{#if disabled}} class="disabled page-item" {{/if}}><a class="page-numbers" href="?p={{n}}">{{n}}</a></li>
                            {{/paginate}}
                        </ul>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</section>
{{>footer}}