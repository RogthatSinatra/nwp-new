<div id="app">
    {{>navbar}}
    <main id="main" class="main spacer-xxxl">
        <div class="specification-template spacer-xxl">
<section class="location-template-news">
          <header class="location-template-news-header has-sweep-fade" style="--reveal: 1;">
            <h2 class="subheading-m text-medium-1">NWP Blog</h2>            <h3 class="heading-l gradient-accent-1">
News & Updates</h3>          </header>
          <div class="news-carousel is-visible" data-header-theme="light">
    <div class="embla">
      <div class="news-carousel-embla">
        <div class="news-carousel-embla-controls carousel-controls">
          <button class="btn text-uppercase carousel-button" type="button" id="news-embla-prev" aria-label="aria_label_previous_news" disabled="disabled"><svg viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M8.06067 14.75L1.06067 7.75L8.06067 0.749999" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"></path>
</svg></button>          <button class="btn text-uppercase carousel-button" type="button" id="news-embla-next" aria-label="aria_label_next_news"><svg viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M0.75 0.75L7.75 7.75L0.75 14.75" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round"></path>
</svg></button>        </div>
        <div class="news-carousel-embla-progress carousel-progress">
          <span class="subheading-m" id="news-embla-progress-current">1</span>          <span class="subheading-m">/</span>          <span class="subheading-m" id="news-embla-progress-total">30</span>        </div>
      </div>
      <div class="embla__viewport">
        <div class="embla__container" style="transform: translate3d(0px, 0px, 0px);">
          {{#each posts}}
                      <div class="embla__slide">
              <a href="{{permalink}}"  class="news-carousel-card">
                <div class="news-carousel-card-image">
                                      <img src="{{mainimage}}" sizes="(min-width: 1840px) 397px, (min-width: 1280px) 294px, 305px" alt="Volta SKAI, the first high-rise in Põhja-Tallinn, receives its cornerstone" loading="lazy" decoding="async">
                                  </div>
                <div class="news-carousel-card-content">
                  <div class="news-carousel-card-title heading-xs">
                    {{title}}
                  </div>
                                    <span class="subheading-m news-carousel-card-date text-medium-1" datetime="2026-04-08T09:59:09">{{dateFormat this.date}}</span>                </div>
              </a>
            </div>
            {{/each}}
       
                  </div>
      </div>
    </div>
  </div>
          <div class="location-template-news-cta">
            <div class="read-more read-more--medium read-more-bordered  read-more-text-left " data-bs-theme="light" role="group" style="--content-opacity: 1; --line-scale: 1;">
      <span class="subheading-m text-medium-1 read-more-label d-block">Discover</span>        <a class="heading-s read-more-link" href="/properties" target="_blank" rel="noopener noreferrer" data-tracking-type="link">
    <span class="read-more-link-text" style="background-size: 100% 2px;">Properties</span>
</a>  </div>
          </div>
        </section>
      </div></main>
      {{>footer2}}