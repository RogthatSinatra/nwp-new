<div id="app">
    {{>navbar}}
    
    <main id="main" class="main spacer-xxxl" style="padding-top: 120px; padding-bottom: 100px;">
        <article class="specification-template spacer-xxl">
            
            <header class="location-template-news-header has-sweep-fade" style="--reveal: 1; max-width: 900px; margin: 0 auto; padding: 0 20px;">
                {{#if article.category}}
                <h2 class="subheading-m text-medium-1" style="margin-bottom: 1rem;">{{article.category}}</h2>
                {{/if}}
                
                <h1 class="heading-l gradient-accent-1" style="margin-bottom: 1.5rem; line-height: 1.2;">{{article.title}}</h1>
                
                {{#if article.summary}}
                <p class="subheading-l" style="margin-bottom: 2rem; opacity: 0.9;">{{article.summary}}</p>
                {{/if}}
                
                <div class="article-meta" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(150, 150, 150, 0.2);">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        {{#if article.author}}
                        <img src="/images/bio/{{article.author}}" alt="{{article.author}}" style="border-radius: 50%; width: 55px; height: 55px; object-fit: cover;" />
                        {{/if}}
                        <div>
                            {{#if article.author}}
                            <span class="subheading-m d-block text-medium-1" style="margin-bottom: 0.2rem;">{{article.author}}</span>
                            {{/if}}
                            <span class="subheading-s" style="opacity: 0.7;">{{dated article.date}}</span>
                        </div>
                    </div>
                    
                    <div>
                        <a href="https://www.addtoany.com/share" class="a2a_dd" style="color: inherit; text-decoration: none; opacity: 0.8; transition: opacity 0.3s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8">
                            <svg fill="currentColor" viewBox="0 0 32 32" width="28px" version="1.1" xmlns="http://www.w3.org/2000/svg">
                                <path d="M28.183 29.668h-26v-20h8.050l2.023-1.948-0.052-0.052h-10.021c-1.105 0-2 0.896-2 2v20c0 1.105 0.895 2 2 2h26c1.105 0 2-0.895 2-2v-15.646l-2 1.909v13.737zM8.442 21.668l2.015-0c1.402-7.953 8.329-14 16.684-14 0.351 0 0.683 0.003 1.019 0.005l-3.664 3.664c-0.39 0.39-0.39 1.024 0 1.414 0.195 0.196 0.452 0.293 0.708 0.293s0.511-0.098 0.706-0.293l5.907-6.063-5.907-6.064c-0.39-0.391-1.023-0.391-1.414 0-0.39 0.391-0.39 1.024 0 1.414l3.631 3.63c-0.314-0-0.624-0.002-0.944-0.002-9.47 0-17.299 6.936-18.741 16.001z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </header>

            {{#if article.mainimage}}
            <figure class="article-main-image" style="max-width: 1200px; margin: 0 auto 4rem auto; padding: 0 20px;">
                <img src="{{article.mainimage}}" alt="{{article.title}}" style="width: 100%; border-radius: 16px; object-fit: cover; box-shadow: 0 15px 35px rgba(0,0,0,0.05);" />
            </figure>
            {{/if}}

            <div class="article-body" style="max-width: 800px; margin: 0 auto; padding: 0 20px; font-size: 1.15rem; line-height: 1.8; margin-bottom: 4rem;">
                {{{article.body}}}
            </div>

            <div class="location-template-news-cta" style="max-width: 900px; margin: 0 auto; padding: 0 20px;">
                <div class="read-more read-more--medium read-more-bordered read-more-text-left" data-bs-theme="light" role="group" style="--content-opacity: 1; --line-scale: 1;">
                    <span class="subheading-m text-medium-1 read-more-label d-block">Explore More</span>
                    <a class="heading-s read-more-link" href="/blog" data-tracking-type="link">
                        <span class="read-more-link-text" style="background-size: 100% 2px;">Back to News</span>
                    </a>
                </div>
            </div>

        </article>
    </main>
    
</div>

{{>footer2}}

<!-- AddToAny BEGIN -->
<script>
var a2a_config = a2a_config || {};
a2a_config.onclick = 1;
a2a_config.num_services = 5;
a2a_config.prioritize = [ 'x', 'facebook', 'whatsapp', 'linkedin', 'copy_link' ];
</script>
<script async src="https://static.addtoany.com/menu/page.js"></script>

<!-- Social Embeds -->
<script async src="//www.instagram.com/embed.js"></script>
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>