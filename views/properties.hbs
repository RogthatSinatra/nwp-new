                                <label class="subheading-s panorama-controls-group-label">Switch</label>
                                <div class="panorama-controls-group-buttons panorama-radio-buttons" role="radiogroup" aria-label="Light">
                                    <input type="radio" name="panorama-static-scene" id="panorama-static-0" value="0" class="panorama-static-input visually-hidden" checked aria-label="Morning">
                                    <label class="text-s panorama-radio-label" for="panorama-static-0" data-tracking-click="view_gallery" data-tracking-type="tab" data-tracking-section="content_section">3 Bedrooms</label> <input type="radio" name="panorama-static-scene" id="panorama-static-1" value="1" class="panorama-static-input visually-hidden" aria-label="Day">
                                    <label class="text-s panorama-radio-label" for="panorama-static-1" data-tracking-click="view_gallery" data-tracking-type="tab" data-tracking-section="content_section">2 Bedrooms</label> <input type="radio" name="panorama-static-scene" id="panorama-static-2" value="2" class="panorama-static-input visually-hidden" aria-label="Evening">
                                </div>
                            </div>
                        </div>
                    </div>
            </section>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
    // 1. Select all the radio inputs and the image containers
    const radioButtons = document.querySelectorAll('.panorama-static-input');
    const imageWrappers = document.querySelectorAll('.panorama-static-image');

    radioButtons.forEach(radio => {
        radio.addEventListener('change', (e) => {
            const selectedIndex = e.target.value;

            // 2. Loop through images to update data-active
            imageWrappers.forEach(img => {
                if (img.getAttribute('data-index') === selectedIndex) {
                    img.setAttribute('data-active', 'true');
                } else {
                    // It's cleaner to remove the attribute or set to false 
                    // depending on how your CSS is written
                    img.setAttribute('data-active', 'false');
                }
            });
        });
    });
});
            </script>
