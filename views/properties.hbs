            <style>
  /* Ensure the container of all images is square */
.panorama-static-images {
    width: 100%;
    /* This forces the height to match the width */
    aspect-ratio: 1 / 1; 
    position: relative;
    overflow: hidden; /* Keeps everything inside the square */
}

/* Ensure each individual image wrapper is also square */
.panorama-static-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
}

/* Force the actual <img> tag to fill the square without stretching */
.panorama-static-image img {
    width: 100%;
    height: 100%;
    /* 'cover' crops the image to fill the square instead of squishing it */
    object-fit: cover; 
    object-position: center;
}

.interior-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem 0 3rem 0;
}
.interior-gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 4/3;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}
.interior-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}
.interior-gallery-item:hover img {
    transform: scale(1.05);
}
.interior-gallery-item {
    cursor: pointer;
}
.interior-gallery-title {
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
}

/* Lightbox Styles */
#interior-lightbox {
    position: fixed;
    z-index: 99999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}
#interior-lightbox.show {
    opacity: 1;
    visibility: visible;
}
#interior-lightbox img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    transform: scale(0.9);
    transition: transform 0.3s ease;
}
#interior-lightbox.show img {
    transform: scale(1);
}
.lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #fff;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
    user-select: none;
    z-index: 100000;
}
.lightbox-close:hover {
    color: #ccc;
}
            </style>

