<style type="text/css">
#canvas {
    width: 200px;
}

.form-group {
    padding-left: 1em;
    padding-right: 1em;
}

h4 {
    color: black;
}

p {
    color: #808080 !important;
}
</style>
<script type="text/javascript">
function updateImage() {
    var x = document.getElementById("mainimage").value;
    // GET THE IMAGE.
    var img = new Image();
    img.src = x;
    // WAIT TILL IMAGE IS LOADED.
    img.onload = function() {
        fill_canvas(img); // FILL THE CANVAS WITH THE IMAGE.
    }

    function fill_canvas(img) {
        // CREATE CANVAS CONTEXT.
        var canvas = document.getElementById('canvas');
        var ctx = canvas.getContext('2d');

        canvas.width = img.width;
        canvas.height = img.height;

        ctx.drawImage(img, 0, 0); // DRAW THE IMAGE TO THE CANVAS.
    }
}

</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var toggleButton = document.getElementById("toggleButton");
    var backdatedElement = document.getElementById("backDated");

    toggleButton.addEventListener("click", function () {
      if (backdatedElement.style.display === "none") {
        backdatedElement.style.display = "block";
      } else {
        backdatedElement.style.display = "none";
      }
    });
  });
</script>


