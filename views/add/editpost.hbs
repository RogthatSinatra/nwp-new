<script src="https://code.jquery.com/jquery-2.2.4.min.js" integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
<script src="https://kit.fontawesome.com/c6c1e18601.js" crossorigin="anonymous"></script>
<link rel="stylesheet" type="text/css" href="/css/froala_editor.min.css">
<style type="text/css">
    #backDated{
        display: none;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<main class="main">
    <!--==================== HOME ====================-->
    <section class="home section" id="home">
        <div class="home__container container grid">
            <div class="container">
                <div class="row">
                    <div class="col-md-10 offset-md-1">
                        <span class="anchor" id="formUserEdit"></span>
                        <a href="/admin"> <img src="/images/logo.png" width="100"></a>
                        {{#each errors}}
                        <div class="alert alert-danger" role="alert">
                            <strong>Oh snap! {{this.msg}}</strong>
                        </div>
                        {{/each}}
                        {{#if message}}
                        <script type="text/javascript">
                        Swal.fire({
                            position: 'top-end',
                            icon: 'success',
                            title: '{{message}}',
                            showConfirmButton: false,
                            timer: 2000
                        })
                        </script>
                        {{/if}}
             
                        <div align="right" class="mb-3"><a onclick="history.back()" class="pointer text-secondary"><i class="fa fa-arrow-left"></i> Go Back</a> <a id="toggleButton" class="pointer text-secondary">Back Date</a></div>
                        <div class="mb-3 col-lg-4" align="right" id="backDated"><form class="form" role="form" method="POST" action="/posts/{{article._id}}/date"><label>Back/Forward date</label><input  name="date" class="form-control mb-3" type="date" value="{{trimDate article.date}}" />
                            <div align="right"><button type="submit" class="btn btn-info btn-sm">Update</button></div></form>
</div>
                        <!-- form user info -->
                        <div class="card card-outline-secondary">
                            <form class="form" role="form" autocomplete="off" method="POST" action="/posts/{{article._id}}/update">
                                <div class="card-header">
                                    <h4 class="mb-0"><img src="/images/bio/{{user.display_name}}" class="biopic2" width="30" height="30" style="border-radius: 50%;"> {{article.title}}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</h4>
                                    <div align="right"><button type="submit" class="btn btn-secondary btn-sm">Update Post</button></div>
                                </div><br />
                                <div class="card-block ">
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label">Title*</label>
                                        <div class="col-lg-9">
                                            <input class="form-control" type="text" id="title" name="title" placeholder="Enter title" required value="{{article.title}}"><br>
                                            <input class="form-control" type="text" id="permalink" name="permalink" placeholder="Permanent-link" required hidden value="{{article.permalink}}">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label"><a title="add category" href="/categories/add">Category*</a></label>
                                        <div class="col-lg-9">
                                            <select class="form-control" name="category" size="0">
                                                <option value="{{article.category}}">{{article.category}}</option>
                                                {{#each categories}}
                                                <option value="{{this.name}}">{{this.name}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label">Author*</label>
                                        <div class="col-lg-9">
                                          
                                                <input type="text" class="form-control" value="{{article.author}}" name="author">
                          
                                          </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label">Summary*</label>
                                        <div class="col-lg-9">
                                            <textarea class="form-control" maxlength="300" name="summary" placeholder="Summary of article max 300..." rows="2" required>{{article.summary}}</textarea>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label">Body*</label>
                                        <div class="col-lg-9">
                                            <textarea class="form-control editor" name="body" placeholder="Enter your text here." rows="100" required>{{{article.body}}}</textarea>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label">Featured</label>
                                        <div class="col-lg-9">
                                            <div class="form-group">
                                                <input type="link" name="mainimage" value="{{article.mainimage}}" class="form-control" id="mainimage" placeholder="Select main image below" required autofocus oninput="updateImage()" hidden>
                                                <input type="text" name="credit" class="form-control" placeholder="photo credit eg.(Oppenheimer Golden Globes)" value="{{article.credit}}" id="credit">
                                            </div>
                                        </div>
                                    </div>
                                    <input type="hidden" name="mainimagefalse" id="exampleInputFile" aria-describedby="fileHelp">
                                    <div class="form-group row">
                                        <label class="col-lg-3 col-form-label form-control-label"></label>
                                        <div class="col-lg-9">
                                            <div class="container">
                                                <div id="drop--area">
                                                    <form class="form" id="form">
                                                        <input type="file" id="file--input" multiple accept="image/*" onchange="handleFiles(this.files)">
                                                        <label for="file--input" class="button jFiler-input-choose-btn btn btn-inverse waves-effect waves-light"><i class="far fa fa-upload"></i> Main Image</label>
                                                        <div id="gallery">
                                                            <figure class="done" id="anImage"><img class="img" src="{{article.mainimage}}"><span class="mainSpan"><span class="spanOne"></span><span class="spanTwo"></span></span><span class="progressSpan" style="height: 0%;"></span></figure>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                            <canvas id="canvas">
                                                Sorry. Your browser does not support HTML5 canvas element.
                                            </canvas>
                                        </div>
                                    </div>
                            </form>
                        </div>
                    </div>
                    <!-- /form user info -->
                </div>
                <!--/col-->
            </div>
        </div>
        </div>
    </section>
</main>
<script async src="//www.instagram.com/embed.js"></script>
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
